{
  "rules": {
    "roomIndex": {
      ".read": "auth != null",
      ".indexOn": [".value"],
      "$code": {
        ".write": "auth != null",
        ".validate": "newData.isNumber()"
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && (data.child('members').child(auth.uid).exists() || (!newData.exists() && root.child('roomIndex').child($code).val() < now - 2592000000))",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.parent().child('members').child(auth.uid).exists())"
        },
        "seats": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "members": {
          "$uid": {
            ".read": "auth != null && auth.uid == $uid",
            ".write": "auth != null && auth.uid == $uid"
          }
        }
      }
    }
  }
}
